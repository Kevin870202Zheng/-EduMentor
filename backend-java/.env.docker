# =============================================================================
# EduMentor — Docker 部署环境变量配置
# =============================================================================
# 使用方式: cp .env.docker .env && docker compose up -d
# 必填项已标注 [REQUIRED]，启动前必须设置
# =============================================================================

# ---- PostgreSQL 数据库 [必填] ----
POSTGRES_USER=edumentor
POSTGRES_PASSWORD=changeme_please_use_strong_password    # [REQUIRED] 修改为强密码
POSTGRES_DB=edumentor

# ---- 应用端口 ----
APP_PORT=8080
ACTUATOR_PORT=8081

# ---- JWT 认证 [必填] ----
JWT_SECRET_KEY=changeme_use_a_256bit_base64_key          # [REQUIRED] 生产环境必须修改
JWT_ACCESS_TOKEN_EXPIRATION=3600                         # 访问令牌有效期（秒）
JWT_REFRESH_TOKEN_EXPIRATION=2592000                     # 刷新令牌有效期（秒，默认30天）

# ---- LLM 服务 ----
LLM_PROVIDER=mock                                        # 可选: mock, openai, zhipu, wenxin, ollama
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# OpenAI (LLM_PROVIDER=openai 时必填)
OPENAI_API_KEY=                                          # [REQUIRED if openai]
OPENAI_API_BASE=https://api.openai.com/v1

# 智谱 AI (LLM_PROVIDER=zhipu 时必填)
ZHIPUAI_API_KEY=                                         # [REQUIRED if zhipu]

# 文心一言 (LLM_PROVIDER=wenxin 时必填)
WENXIN_API_KEY=                                          # [REQUIRED if wenxin]
WENXIN_SECRET_KEY=                                       # [REQUIRED if wenxin]

# Ollama (LLM_PROVIDER=ollama 时必填)
OLLAMA_BASE_URL=http://host.docker.internal:11434        # Docker Desktop 访问宿主机

# ---- RAG 引擎 ----
RAG_ENABLED=true
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=text-embedding-3-small

# ---- BKT 贝叶斯知识追踪 ----
BKT_P_LEARN=0.3
BKT_P_GUESS=0.2
BKT_P_SLIP=0.1
BKT_P_INIT=0.4
BKT_MASTERY_THRESHOLD=0.95

# ---- 学情诊断 ----
DIAGNOSIS_MASTERY_THRESHOLD=0.8
DIAGNOSIS_WEAK_THRESHOLD=0.5
DIAGNOSIS_ZPD_RANGE=0.2
DIAGNOSIS_FORGETTING_CURVE_INTERVALS=1,7,30,90

# ---- 预警系统 ----
ALERT_CHECK_INTERVAL=3600000                             # 检查间隔（毫秒）
ALERT_BLUE_THRESHOLD=0.7
ALERT_YELLOW_THRESHOLD=0.5
ALERT_ORANGE_THRESHOLD=0.4
ALERT_RED_THRESHOLD=0.3

# ---- WebSocket ----
WEBSOCKET_ENDPOINT=/ws/chat
WEBSOCKET_HEARTBEAT_INTERVAL=30000                       # 心跳间隔（毫秒）
WEBSOCKET_MAX_TEXT_MESSAGE_SIZE=65536                    # 最大消息大小（字节）
WEBSOCKET_MAX_SESSION_IDLE_TIMEOUT=600000                # 会话超时（毫秒）

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 日志级别 ----
LOGGING_LEVEL_COM_EDUMENTOR=INFO
