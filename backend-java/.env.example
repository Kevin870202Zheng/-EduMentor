# =============================================================================
# EduMentor Backend — 环境变量配置示例
# =============================================================================
# 使用方式: cp .env.example .env && 按需修改
# =============================================================================

# ---- 数据库 (PostgreSQL) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/edumentor
DATABASE_USERNAME=edumentor
DATABASE_PASSWORD=edumentor@123

# ---- JWT 认证 ----
JWT_SECRET_KEY=your-secure-jwt-secret-key-at-least-256-bits-long
JWT_ACCESS_TOKEN_EXPIRATION=3600          # 访问令牌有效期（秒）
JWT_REFRESH_TOKEN_EXPIRATION=2592000      # 刷新令牌有效期（秒）

# ---- LLM 服务 ----
LLM_PROVIDER=MOCK                          # 可选: MOCK, OPENAI, ZHIPU, WENXIN, OLLAMA
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_RATE_LIMIT=120                         # 每分钟最大请求数
LLM_MAX_TOKENS_PER_MINUTE=200000           # 每分钟最大 Token 数

# OpenAI (LLM_PROVIDER=OPENAI 时必填)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1

# 智谱 AI (LLM_PROVIDER=ZHIPU 时必填)
ZHIPUAI_API_KEY=

# 文心一言 (LLM_PROVIDER=WENXIN 时必填)
WENXIN_API_KEY=
WENXIN_SECRET_KEY=

# Ollama (LLM_PROVIDER=OLLAMA 时必填)
OLLAMA_BASE_URL=http://localhost:11434

# ---- RAG 引擎 ----
RAG_ENABLED=true
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_VECTOR_DB_PATH=data/vector_store.json
RAG_DATA_DIR=data/rag

# ---- BKT 贝叶斯知识追踪 ----
BKT_ENABLED=true
BKT_P_INIT=0.15
BKT_P_LEARN=0.25
BKT_P_GUESS=0.15
BKT_P_SLIP=0.10
BKT_MASTERY_THRESHOLD=0.95

# ---- 学情诊断 ----
DIAGNOSIS_MASTERY_THRESHOLD=0.80
DIAGNOSIS_WEAK_THRESHOLD=0.50
DIAGNOSIS_ZPD_RANGE=0.15
DIAGNOSIS_FORGETTING_CURVE_INTERVALS=1,3,7,14,30,60,120

# ---- 预警系统 ----
ALERT_CHECK_INTERVAL=3600                   # 检查间隔（秒）
ALERT_BLUE_THRESHOLD=0.60
ALERT_YELLOW_THRESHOLD=0.50
ALERT_ORANGE_THRESHOLD=0.40
ALERT_RED_THRESHOLD=0.30

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 日志级别 ----
LOGGING_LEVEL_COM_EDUMENTOR=DEBUG
